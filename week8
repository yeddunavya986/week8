      "cell_type": "code",
      "source": [
        "api_key = userdata.get(\"GROQ_API_KEY\")\n",
        "client = Groq(api_key=api_key)\n"
      ],
      "metadata": {
        "id": "8KYk5pjK-ly0"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Structured Format Prompt\n",
        "\n",
        "prompt = \"\"\"\n",
        "List three benefits of daily exercise.\n",
        "\n",
        "Requirements:\n",
        "1. First, give the answer as a bullet list.\n",
        "2. Then create a Markdown table.\n",
        "3. The table must have two columns:\n",
        "   - Benefit\n",
        "   - Description\n",
        "\"\"\"\n",
        "\n",
        "response = client.chat.completions.create(\n",
        "    model=\"llama-3.3-70b-versatile\",\n",
        "    messages=[\n",
        "        {\"role\": \"user\", \"content\": prompt}\n",
        "    ]\n",
        ")\n",
        "\n",
        "print(\"========== Prompt ==========\\n\")\n",
        "print(prompt)\n",
        "\n",
        "print(\"\\n========== Output ==========\\n\")\n",
        "print(response.choices[0].message.content)\n"
      ],
